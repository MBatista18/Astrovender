  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Gun puzzle:

    There are 3 pillars, each placed in one of the 3 nearby
    puddles


    The 3 pillars must be attacked in succession to activate them and
    grant the player a reward, but the pillars deactivate quickly after getting attacked


    Because
    of this, the player cannot get all 3 pillars with their melee alone, as travel
    time between the pillars will be too slow. They must use their gun to activate
    at least one of the pillars'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
